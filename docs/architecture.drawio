<mxfile host="drawio" agent="sezzle-calculator diagram generator" version="24.7.17">
  <diagram id="arch" name="1. Arquitectura">
    <mxGraphModel dx="1700" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="arch-1" value='&lt;font style="font-size:20px"&gt;&lt;b&gt;Sezzle Calculator: arquitectura&lt;/b&gt;&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell>
        <mxCell id="arch-2" value="SPA en React que delega toda la aritmética en una API REST en Go. El navegador no calcula nada: solo gestiona la entrada y la presentación." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1660" height="24" as="geometry"/></mxCell>
        <mxCell id="arch-3" value="Usuario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="165" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="arch-4" value="&lt;b&gt;Navegador · React 19 + TypeScript (Vite)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;dashed=1;fontSize=14;spacingLeft=12;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="130" y="90" width="560" height="830" as="geometry"/></mxCell>
        <mxCell id="arch-5" value='&lt;b&gt;Presentación  ·  src/components&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;App.tsx: layout y ayuda de teclado&lt;br&gt;Calculator.tsx: display (aria-live), teclado de 22 botones,&lt;br&gt;listener de teclado global&lt;br&gt;Calculator.css + index.css: responsive, tema claro/oscuro&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="arch-6" value='&lt;b&gt;Orquestación  ·  useCalculator.ts (hook)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Cola FIFO de teclas drenada por un único bucle async&lt;br&gt;Estado autoritativo en un ref (sin renders obsoletos)&lt;br&gt;Una petición a la vez; si falla, descarta la cola&lt;br&gt;calculate() inyectable para tests&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="300" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="arch-7" value='&lt;b&gt;Lógica de estado pura  ·  src/calculator&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;state.ts: planKey(state, key) → acción local | petición al API&lt;br&gt;            reducer(state, action) → nuevo estado&lt;br&gt;operations.ts: 7 operaciones (aridad, símbolo)&lt;br&gt;format.ts: 12 cifras significativas · keys.ts: mapa de teclado&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="450" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="arch-8" value='&lt;b&gt;Acceso a datos  ·  src/api/client.ts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;calculate(op, operands): Promise&amp;lt;number&amp;gt;&lt;br&gt;fetch POST {VITE_API_URL}/api/v1/{op}&lt;br&gt;Errores HTTP / red / respuesta inválida → CalculatorApiError&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="630" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="arch-9" value='&lt;b&gt;Calidad&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Vitest + Testing Library + jsdom · 77 tests&lt;br&gt;100 % sentencias · 97 % ramas&lt;br&gt;ESLint + tsc (strict) en el build&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="780" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="arch-10" value="clic / teclado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-3" target="arch-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch-11" value="press(key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arch-5" target="arch-6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch-12" value="planKey() · reducer()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arch-6" target="arch-7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch-13" value="calculate()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=1;entryY=0.25;" edge="1" parent="1" source="arch-6" target="arch-8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch-14" value='&lt;b&gt;Contrato HTTP / JSON&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;→ POST /api/v1/{operation}&lt;br&gt;   {&amp;quot;operands&amp;quot;:[8,2]}&lt;br&gt;&lt;br&gt;← 200 {&amp;quot;operation&amp;quot;,&amp;quot;operands&amp;quot;,&amp;quot;result&amp;quot;}&lt;br&gt;&lt;br&gt;← 4xx {&amp;quot;error&amp;quot;:{&amp;quot;code&amp;quot;,&amp;quot;message&amp;quot;}}&lt;br&gt;   400 petición inválida&lt;br&gt;   404 operación desconocida&lt;br&gt;   413 cuerpo &amp;gt; 1 KiB&lt;br&gt;   422 sin resultado matemático&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="735" y="560" width="230" height="230" as="geometry"/></mxCell>
        <mxCell id="arch-15" value="fetch()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arch-8" target="arch-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch-16" value="&lt;b&gt;Servidor Go · net/http (sin dependencias externas)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;dashed=1;fontSize=14;spacingLeft=12;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="1010" y="90" width="660" height="830" as="geometry"/></mxCell>
        <mxCell id="arch-17" value='&lt;b&gt;Proceso  ·  main.go&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Config por entorno: PORT · CORS_ORIGIN · STATIC_DIR&lt;br&gt;Timeouts de lectura/escritura · apagado ordenado (SIGINT/SIGTERM)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="arch-18" value='&lt;b&gt;Cadena de middleware  ·  middleware.go&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;withRecovery (panic → 500 JSON)  →  withLogging (slog)  →  withCORS  →  ServeMux&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="270" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="arch-19" value='&lt;b&gt;Router  ·  router.go (ServeMux Go 1.22+)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;font face="Courier New" style="font-size:11px"&gt;GET&amp;nbsp;&amp;nbsp;/api/health&lt;br&gt;GET&amp;nbsp;&amp;nbsp;/api/v1/operations&lt;br&gt;POST&amp;nbsp;/api/v1/{operation}&lt;br&gt;/api/*&amp;nbsp;&amp;nbsp;→&amp;nbsp;404&amp;nbsp;JSON&lt;br&gt;/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→&amp;nbsp;SPA&amp;nbsp;(si&amp;nbsp;STATIC_DIR)&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="400" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="arch-20" value='&lt;b&gt;spaHandler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Sirve el build de React (dist/)&lt;br&gt;desde STATIC_DIR&lt;br&gt;Rutas desconocidas → index.html&lt;br&gt;Solo en el despliegue Docker&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="400" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="arch-21" value='&lt;b&gt;Transporte  ·  handlers.go&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;decodeJSON estricto: 1 KiB máx., sin campos desconocidos, un solo valor, null rechazado&lt;br&gt;classify(err): error del dominio → status HTTP + código estable&lt;br&gt;writeJSON / writeError: sobre de error único&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="610" width="600" height="110" as="geometry"/></mxCell>
        <mxCell id="arch-22" value='&lt;b&gt;Dominio  ·  internal/calculator (sin HTTP)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Calculate(op, operands...) · Arity(op) · Operations()&lt;br&gt;Tabla de operaciones: add, subtract, multiply, divide, power, sqrt, percentage&lt;br&gt;Errores centinela: ErrDivisionByZero, ErrNegativeSqrt, ErrResultOutOfRange…&lt;br&gt;Garantiza resultados finitos y normaliza −0 → 0   ·   go test: 100 % (api 98 %)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="760" width="600" height="130" as="geometry"/></mxCell>
        <mxCell id="arch-23" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-14" target="arch-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arch-24" value="NewRouter(Config)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arch-17" target="arch-18"><mxGeometry relative="1" as="geometry"/></mxCell>
