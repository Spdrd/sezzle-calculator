        <mxCell id="deploy-1" value='&lt;font style="font-size:20px"&gt;&lt;b&gt;Entornos de ejecución&lt;/b&gt;&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell>
        <mxCell id="deploy-2" value="&lt;b&gt;Desarrollo local (dos procesos)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;dashed=1;fontSize=14;spacingLeft=12;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="780" height="520" as="geometry"/></mxCell>
        <mxCell id="deploy-3" value='&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;http://localhost:5173&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="deploy-4" value='&lt;b&gt;Vite dev server :5173&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;npm run dev&lt;br&gt;HMR · sirve src/ transpilado&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="deploy-5" value='&lt;b&gt;API Go :8080&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;go run .&lt;br&gt;CORS_ORIGIN=http://localhost:5173&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="deploy-6" value='&lt;b&gt;frontend/&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;React + TypeScript&lt;br&gt;Vitest (npm test)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="deploy-7" value='&lt;b&gt;backend/&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Go 1.23+&lt;br&gt;go test ./...&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="deploy-8" value="GET /, assets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy-3" target="deploy-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="deploy-9" value="proxy /api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy-4" target="deploy-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="deploy-10" value="El proxy de Vite reenvía &lt;b&gt;/api/*&lt;/b&gt; a &lt;b&gt;localhost:8080&lt;/b&gt;, así que el navegador solo habla con un origen. CORS queda habilitado para &lt;i&gt;http://localhost:5173&lt;/i&gt; por si el frontend llama al API directamente (VITE_API_URL)." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="720" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy-11" value="&lt;b&gt;Docker (un solo contenedor)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;dashed=1;fontSize=14;spacingLeft=12;spacingTop=6;opacity=60;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="840" height="800" as="geometry"/></mxCell>
        <mxCell id="deploy-12" value='&lt;b&gt;Etapa 1 · node:22-alpine&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;npm ci&lt;br&gt;npm run build&lt;br&gt;→ dist/ (HTML, JS, CSS)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy-13" value='&lt;b&gt;Etapa 2 · golang:1.27-alpine&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CGO_ENABLED=0 go build&lt;br&gt;-trimpath -ldflags=&amp;quot;-s -w&amp;quot;&lt;br&gt;→ /out/calculator&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy-14" value='&lt;b&gt;Etapa 3 · distroless/static:nonroot&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/app/calculator&lt;br&gt;/app/public  (dist/)&lt;br&gt;USER nonroot · sin shell&lt;br&gt;Imagen ≈ 16 MB&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1005" y="310" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="deploy-15" value="COPY dist/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy-12" target="deploy-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="deploy-16" value="COPY binario" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy-13" target="deploy-14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="deploy-17" value='&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;http://localhost:8080&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="560" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="deploy-18" value='&lt;b&gt;Proceso /app/calculator  :8080&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;ENV STATIC_DIR=/app/public  ·  CORS_ORIGIN=&amp;quot;&amp;quot; (desactivado)&lt;br&gt;&lt;br&gt;/api/*  → handlers JSON&lt;br&gt;/        → spaHandler (index.html + assets)&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="480" height="160" as="geometry"/></mxCell>
        <mxCell id="deploy-19" value="docker run -p 8080:8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy-14" target="deploy-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="deploy-20" value="mismo origen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy-17" target="deploy-18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="deploy-21" value="&lt;b&gt;docker build -t sezzle-calculator .&lt;/b&gt;&lt;br&gt;&lt;b&gt;docker run --rm -p 8080:8080 sezzle-calculator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Un solo binario sirve la SPA y el API en el mismo origen: no hace falta CORS ni proxy inverso." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="780" height="120" as="geometry"/></mxCell>
        <mxCell id="deploy-22" value='&lt;b&gt;Variables de configuración&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&lt;font face="Courier New" style="font-size:11px"&gt;PORT&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;8080&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;puerto&amp;nbsp;del&amp;nbsp;backend&lt;br&gt;CORS_ORIGIN&amp;nbsp;&amp;nbsp;&amp;nbsp;http://localhost:5173&amp;nbsp;&amp;nbsp;&amp;nbsp;Access-Control-Allow-Origin&amp;nbsp;(&amp;quot;&amp;quot;&amp;nbsp;lo&amp;nbsp;desactiva)&lt;br&gt;STATIC_DIR&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(vacío)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;carpeta&amp;nbsp;del&amp;nbsp;build&amp;nbsp;de&amp;nbsp;React&amp;nbsp;a&amp;nbsp;servir&amp;nbsp;en&amp;nbsp;/&lt;br&gt;VITE_API_URL&amp;nbsp;&amp;nbsp;(vacío&amp;nbsp;=&amp;nbsp;mismo&amp;nbsp;origen)&amp;nbsp;&amp;nbsp;URL&amp;nbsp;base&amp;nbsp;del&amp;nbsp;API&amp;nbsp;en&amp;nbsp;tiempo&amp;nbsp;de&amp;nbsp;build&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="780" height="140" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
