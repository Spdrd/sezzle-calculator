        <mxCell id="seq-33" value='"Cannot divide by zero" (role=alert)' style="html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="846" as="sourcePoint"/><mxPoint x="125" y="846" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="seq-34" value='&lt;b&gt;Camino feliz (p. ej. 8 ÷ 2 =)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;9 → 4 · 10 ← 200 {&amp;quot;operation&amp;quot;:&amp;quot;divide&amp;quot;,&amp;quot;operands&amp;quot;:[8,2],&amp;quot;result&amp;quot;:4}&lt;br&gt;11 → plan.onSuccess(4) → reducer({type:&amp;#x27;evaluated&amp;#x27;}) → display &amp;quot;4&amp;quot;, expresión &amp;quot;8 ÷ 2 =&amp;quot;&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="902" width="820" height="90" as="geometry"/></mxCell>
        <mxCell id="seq-35" value='&lt;b&gt;Teclas durante la petición&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Las teclas pulsadas mientras hay una petición en vuelo se encolan y se aplican en orden al terminar.&lt;br&gt;Si la petición falla, la cola se descarta para que el error quede visible.&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="902" width="760" height="90" as="geometry"/></mxCell>
