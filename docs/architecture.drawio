        <mxCell id="seq-22" value="4. reducer({type:'request'}) → pending" style="html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535" y="334" as="sourcePoint"/><mxPoint x="740" y="334" as="targetPoint"/></mxGeometry></mxCell>
