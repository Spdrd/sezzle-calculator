        <mxCell id="seq-25" value="7. recovery → logging → CORS → mux" style="html=1;endArrow=block;endFill=1;strokeWidth=1.2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="472" as="sourcePoint"/><mxPoint x="1355" y="472" as="targetPoint"/></mxGeometry></mxCell>
